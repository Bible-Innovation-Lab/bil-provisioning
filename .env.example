# bil-provisioning environment variables.
# These live ONLY in this service's Vercel project settings in production —
# never on student machines, never in the launchpad template.

# --- GitHub OAuth App (registered under Bible-Innovation-Lab org) ---
# Public — committed into launchpad's setup.sh:
GITHUB_OAUTH_CLIENT_ID=
# Secret — never leaves this service:
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub org / team gates ---
GITHUB_ORG=Bible-Innovation-Lab
GITHUB_ADMIN_TEAM_SLUG=platform-admins

# --- Vercel team admin token (HIGH VALUE — rotate quarterly) ---
# Discover VERCEL_TEAM_ID once via `vercel teams ls` after `vercel login`.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# --- PostHog ---
# v1: one project, app_id dimension on every event. POSTHOG_KEY is the
# project's write-only public key (safe to ship to every student fork).
# POSTHOG_ADMIN_TOKEN is reserved for v1.1 when we add per-product projects.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ADMIN_TOKEN=

# --- YouVersion Platform API ---
# Server-side shared key. Header shape: `X-YVP-App-Key: <key>`.
# Injected into every student project so their /api/v1/bible/* handlers
# can hit YouVersion server-side. Get a key at https://platform.youversion.com.
YOUVERSION_API_KEY=

# --- Vercel KV (Upstash Redis under the hood) — THIS SERVICE's claim store ---
# Used only by bil-provisioning itself for the atomic app-id claim (lib/kv.ts).
# Vercel auto-injects these when KV is linked to the project. Listed here for
# local-dev parity. Student apps must NEVER use this instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Shared Upstash Redis for STUDENT-APP multiplayer ---
# A SEPARATE Upstash Redis (REST) instance from the claim store above.
# When set, /provision injects these into every student project as
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN so games built on
# `@bil/launchpad/realtime` get cross-invocation state with zero config.
# Keys are namespaced per-app (by APP_ID) so one instance is safe to share.
#
# OPTIONAL: leave both blank to skip injection — apps then fall back to a
# dev-only in-memory store (multiplayer won't work across Vercel invocations).
# Create one at https://console.upstash.com (or via the Upstash integration
# on the Vercel team) and paste the REST URL + token here.
APP_UPSTASH_REDIS_REST_URL=
APP_UPSTASH_REDIS_REST_TOKEN=

# --- Service config ---
SUBDOMAIN_ROOT=bibleinnovationlab.org
LOG_LEVEL=info
