{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.2.0"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/provision", "destination": "/api/provision" },
    { "source": "/teardown", "destination": "/api/teardown" },
    { "source": "/status", "destination": "/api/status" }
  ]
}
